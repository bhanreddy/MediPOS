# Use only the public Supabase project URL and publishable/anon key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Local Vite /api proxy points to http://127.0.0.1:5001.
# Set the deployed HTTPS API origin for a hosted build, for example https://api.example.com/api.
VITE_API_URL=http://127.0.0.1:5001/api
