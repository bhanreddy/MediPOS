[Unit]
Description=Encrypted Medical POS PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=medical-backup
Group=medical-backup
EnvironmentFile=/etc/medical-pos/backup.env
ExecStart=/opt/medical-pos/backend/scripts/backup-postgres.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/medical-pos-backups
